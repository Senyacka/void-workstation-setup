#!/bin/sh
# healthcheck - быстрый осмотр системы: сессия, звук, питание, обновления.
#
# Показывает только то, что реально ломается или настраивалось вручную.
# Ничего не меняет и не требует root (строка с dmesg просто помечается).
#
#   healthcheck              цветной отчёт
#   healthcheck --quiet      без вывода, только код возврата 0/1/2
#   healthcheck --json       машиночитаемый вывод
#   healthcheck --section a,b   только указанные секции
#   healthcheck --hints      печатать команды исправления
#   healthcheck --no-color   без ANSI-цветов
set -u

COLOR=1
QUIET=0
JSON=0
HINTS=0
SECTIONS=${HEALTHCHECK_SECTIONS:-system,memory,audio,graphics,session,portal,look,power,thermal,browser,network,disk,updates,configs}

while [ $# -gt 0 ]; do
    case $1 in
        --quiet|-q) QUIET=1 ;;
        --json) JSON=1; QUIET=0 ;;
        --no-color) COLOR=0 ;;
        --hints) HINTS=1 ;;
        --section) SECTIONS=${2:?}; shift ;;
        --section=*) SECTIONS=${1#*=} ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        *) printf 'healthcheck: неизвестный аргумент %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

if [ "$COLOR" = 1 ] && [ -t 1 ]; then
    C_B=$(printf '\033[1;36m'); C_OK=$(printf '\033[32m'); C_BAD=$(printf '\033[31m')
    C_WARN=$(printf '\033[33m'); C_OFF=$(printf '\033[0m')
else
    C_B=; C_OK=; C_BAD=; C_WARN=; C_OFF=
fi

ERRORS=0
WARNINGS=0
JSON_ITEMS=

_read() { cat "$1" 2>/dev/null || true; }
first_battery() {
    for dev in /sys/class/power_supply/*; do
        [ -d "$dev" ] || continue
        [ "$(_read "$dev/type")" = Battery ] && { basename "$dev"; return 0; }
    done
}
first_ac() {
    for dev in /sys/class/power_supply/*; do
        [ -d "$dev" ] || continue
        case $(_read "$dev/type") in Mains|USB) basename "$dev"; return 0 ;; esac
    done
}
fan_hwmon() {
    for dev in /sys/class/hwmon/*; do
        [ -r "$dev/fan1_input" ] || continue
        case $(_read "$dev/name") in asus*|thinkpad|dell_smm|acer-wmi|msi-ec) printf '%s\n' "$dev"; return 0 ;; esac
    done
}
backlight_path() {
    for dev in /sys/class/backlight/*; do
        [ -r "$dev/brightness" ] && { printf '%s\n' "$dev"; return 0; }
    done
}
has_section() {
    case ",$SECTIONS," in *",$1,"*) return 0 ;; *) return 1 ;; esac
}

heading() {
    [ "$JSON" = 1 ] && return 0
    [ "$QUIET" = 1 ] && return 0
    printf '\n%s== %s ==%s\n' "$C_B" "$1" "$C_OFF"
}
record() {
    level=$1; name=$2; detail=$3; hint=${4:-}
    case $level in
        bad) ERRORS=$((ERRORS + 1)) ;;
        warn) WARNINGS=$((WARNINGS + 1)) ;;
    esac
    if [ "$JSON" = 1 ]; then
        JSON_ITEMS="$JSON_ITEMS{\"level\":\"$level\",\"check\":\"$name\",\"detail\":\"$detail\"},"
        return 0
    fi
    [ "$QUIET" = 1 ] && return 0
    case $level in
        ok)   printf '  %s[ok]%s %s\n' "$C_OK" "$C_OFF" "$detail" ;;
        bad)  printf '  %s[!!]%s %s\n' "$C_BAD" "$C_OFF" "$detail" ;;
        warn) printf '  %s[--]%s %s\n' "$C_WARN" "$C_OFF" "$detail" ;;
    esac
    [ "$HINTS" = 1 ] && [ -n "$hint" ] && printf '       %s→ %s%s\n' "$C_WARN" "$hint" "$C_OFF"
    return 0
}

svc_running() { sv status "$1" 2>/dev/null | grep -q '^run:'; }
SUDO_OK=
sudo -n true 2>/dev/null && SUDO_OK=1 || SUDO_OK=
# Системные сервисы видны только root: без sudo проверку пропускаем честно.
svc_running_system() {
    [ -n "$SUDO_OK" ] || return 0
    sudo -n sv status "/var/service/$1" 2>/dev/null | grep -q '^run:'
}

if has_section system; then
    heading "Система"
    record ok kernel "ядро: $(uname -r)"
    record ok uptime "uptime: $(uptime -p 2>/dev/null || cut -d. -f1 /proc/uptime)"
    if [ -z "$SUDO_OK" ]; then
        record warn services "проверка сервисов требует sudo без пароля - пропущена"
    else
        failed=
        count=0
        for sv in /var/service/*; do
            [ -e "$sv" ] || continue
            count=$((count + 1))
            svc_running_system "$(basename "$sv")" || failed="$failed $(basename "$sv")"
        done
        if [ -n "$failed" ]; then
            record bad services "не запущены:$failed" "sudo sv status <имя>; sudo sv restart <имя>"
        else
            record ok services "все $count сервисов в /var/service запущены"
        fi
    fi
fi

if has_section memory; then
    heading "Память и swap"
    record ok swappiness "vm.swappiness = $(_read /proc/sys/vm/swappiness)"
    if [ "$(_read /sys/module/zswap/parameters/enabled)" = Y ]; then
        record ok zswap "zswap включён (компрессор: $(_read /sys/module/zswap/parameters/compressor))"
    else
        record warn zswap "zswap выключен" "добавь zswap.enabled=1 в параметры ядра"
    fi
    [ "$QUIET" = 0 ] && [ "$JSON" = 0 ] && free -h 2>/dev/null | sed -n '2,3p' | sed 's/^/  /'
fi

if has_section audio; then
    heading "Аудио"
    for svc in pipewire wireplumber pipewire-pulse; do
        unit=$HOME/.config/service/$svc
        if [ -d "$unit" ] && svc_running "$unit"; then
            record ok "$svc" "$svc запущен (runit)"
        elif pgrep -x "$svc" >/dev/null 2>&1; then
            record ok "$svc" "$svc работает (не под runit)"
        else
            record bad "$svc" "$svc не запущен" "sv status $unit; sv restart $unit"
        fi
    done
    if timeout 5 pactl info >/dev/null 2>&1; then
        record ok pulse "Pulse-слой отвечает"
    else
        record bad pulse "Pulse-слой не отвечает" "перезапусти wireplumber и pipewire-pulse"
    fi
fi

if has_section graphics; then
    heading "Графика"
    if command -v vainfo >/dev/null 2>&1 && timeout 10 vainfo >/dev/null 2>&1; then
        driver=$(timeout 10 vainfo 2>/dev/null | sed -n 's/.*Driver version: //p' | head -1)
        record ok vaapi "VA-API: ${driver:-есть}"
    else
        record warn vaapi "VA-API недоступен (нет vainfo или драйвера)"
    fi
    if command -v vulkaninfo >/dev/null 2>&1; then
        card=$(timeout 10 vulkaninfo --summary 2>/dev/null | sed -n 's/.*deviceName *= *//p' | head -1)
        [ -n "$card" ] && record ok vulkan "Vulkan: $card" || record warn vulkan "Vulkan: устройство не найдено"
    fi
fi

if has_section session; then
    heading "Сессия"
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        record ok wayland "Wayland-сессия активна ($WAYLAND_DISPLAY)"
    else
        record warn wayland "нет Wayland-сессии в этом окружении"
    fi
    if pgrep -x qs >/dev/null 2>&1; then
        record ok dms "шелл DMS запущен"
    elif command -v dms >/dev/null 2>&1; then
        record bad dms "шелл DMS не запущен" "dms run"
    fi
    if [ -d /var/service/greetd ]; then
        if [ -z "$SUDO_OK" ] || svc_running_system greetd; then
            record ok greetd "greetd включён (вход через greeter)"
        else
            record bad greetd "greetd включён, но не работает" "sudo sv status greetd"
        fi
    else
        record warn greetd "greetd не включён" "sudo ln -s /etc/sv/greetd /var/service"
    fi
    if command -v niri >/dev/null 2>&1; then
        if niri validate -c "$HOME/.config/niri/config.kdl" >/dev/null 2>&1; then
            record ok niri "конфиг niri валиден"
        else
            record bad niri "конфиг niri не проходит validate" "niri validate -c ~/.config/niri/config.kdl"
        fi
    fi
fi

if has_section portal; then
    heading "Порталы"
    if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        sc=$(timeout 8 gdbus call --session --dest org.freedesktop.portal.Desktop \
            --object-path /org/freedesktop/portal/desktop \
            --method org.freedesktop.DBus.Properties.Get \
            org.freedesktop.portal.ScreenCast version 2>/dev/null)
        [ -n "$sc" ] && record ok screencast "ScreenCast отвечает ($sc)" \
            || record bad screencast "ScreenCast не отвечает" "проверь xdg-desktop-portal-*"
    else
        record warn portal "нет сессионной шины D-Bus"
    fi
fi

if has_section look; then
    heading "Тема и шрифты"
    if fc-list 2>/dev/null | grep -qi 'FiraCode Nerd'; then
        record ok font-mono "FiraCode Nerd Font есть"
    else
        record bad font-mono "нет FiraCode Nerd Font" "fc-list | grep -i fira"
    fi
    if fc-list 2>/dev/null | grep -qi 'Roboto'; then
        record ok font-ui "Roboto есть"
    else
        record warn font-ui "нет шрифта Roboto" "sudo xbps-install fonts-roboto-ttf"
    fi
    theme=$(sed -n 's/^gtk-theme-name=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null)
    [ -n "$theme" ] && record ok gtk "GTK-тема: $theme" || record warn gtk "GTK-тема не задана"
    [ -f "$HOME/.local/share/themes/adw-gtk3-glass/gtk-3.0/gtk.css" ] \
        && record ok glass "стеклянная тема собрана" \
        || record warn glass "стеклянной темы нет" "theme-sync dark"
fi

if has_section power; then
    heading "Питание"
    if command -v powerprofilesctl >/dev/null 2>&1; then
        record ok ppd "профиль питания: $(powerprofilesctl get 2>/dev/null)"
    fi
    profile=$(_read /sys/firmware/acpi/platform_profile)
    [ -n "$profile" ] && record ok platform_profile "platform_profile: $profile"
    bat=$(first_battery)
    if [ -n "${bat:-}" ]; then
        cap=$(_read "/sys/class/power_supply/$bat/capacity")
        record ok battery "батарея $bat: ${cap:-?}%"
        attr=
        for a in charge_control_end_threshold charge_stop_threshold; do
            [ -e "/sys/class/power_supply/$bat/$a" ] && { attr=$a; break; }
        done
        if [ -n "$attr" ]; then
            limit=$(_read "/sys/class/power_supply/$bat/$attr")
            want=$(_read /var/lib/battery-charge-limit/limit)
            if [ -n "$want" ] && [ "$limit" != "$want" ]; then
                record warn charge-limit "лимит заряда $limit%, ожидается $want%" \
                    "sudo battery-charge-limit enforce"
            else
                record ok charge-limit "лимит заряда ${limit:-не задан}%"
            fi
        fi
    fi
    if [ -e /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw ]; then
        pl1=$(( $(_read /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw) / 1000000 ))
        ac=$(first_ac)
        state=$(_read "/sys/class/power_supply/${ac:-none}/online")
        record ok rapl "PL1 ${pl1} Вт (источник: ${state:+$([ "$state" = 1 ] && echo AC || echo батарея)})"
    fi
    s_ok=$(_read /sys/power/suspend_stats/success)
    s_fail=$(_read /sys/power/suspend_stats/fail)
    [ -n "$s_ok" ] && record ok suspend "сон: успешно ${s_ok:-0}, неудачно ${s_fail:-0}"
fi

if has_section thermal; then
    heading "Температуры"
    temps=
    tmax=0
    for t in /sys/class/thermal/thermal_zone*/temp; do
        v=$(_read "$t")
        case $v in ''|*[!0-9]*) continue ;; esac
        [ "$v" -ge 1000 ] || continue
        c=$(( v / 1000 ))
        temps="$temps$c"
        [ "$c" -gt "$tmax" ] && tmax=$c
    done
    [ -n "$temps" ] && record ok temps "пик ${tmax}°C"
    fan=$(fan_hwmon)
    if [ -n "${fan:-}" ]; then
        rpm=$(_read "$fan/fan1_input")
        mode=$(_read "${XDG_CACHE_HOME:-$HOME/.cache}/fanmode/mode")
        record ok fan "вентилятор: ${rpm:-?} rpm · режим ${mode:-не задан}"
    fi
fi

if has_section browser; then
    heading "Браузер"
    if pgrep -f 'lib/firefox/firefox' >/dev/null 2>&1; then
        pid=$(pgrep -f 'lib/firefox/firefox' | head -1)
        if tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^WAYLAND_DISPLAY='; then
            record ok firefox "Firefox работает нативно через Wayland"
        else
            record warn firefox "Firefox работает через XWayland"
        fi
    else
        record ok firefox "Firefox не запущен (проверка пропущена)"
    fi
fi

if has_section network; then
    heading "Сеть"
    if command -v nmcli >/dev/null 2>&1; then
        state=$(nmcli -t -f RUNNING general 2>/dev/null)
        [ "$state" = running ] && record ok nm "NetworkManager работает" \
            || record bad nm "NetworkManager не работает" "sudo sv restart NetworkManager"
    fi
    if ip route 2>/dev/null | grep -q '^default'; then
        record ok route "маршрут по умолчанию есть"
    else
        record bad route "нет маршрута по умолчанию" "nmcli connection up <имя>"
    fi
fi

if has_section disk; then
    heading "Диск"
    root_use=$(df -h / 2>/dev/null | awk 'NR == 2 { print $5 }')
    root_free=$(df -h / 2>/dev/null | awk 'NR == 2 { print $4 }')
    record ok root "корень: занято $root_use, свободно $root_free"
    if [ -d /boot/efi ]; then
        efi_use=$(df -h /boot/efi 2>/dev/null | awk 'NR == 2 { print $5 }')
        efi_num=${efi_use%\%}
        case $efi_num in
            ''|*[!0-9]*) : ;;
            *) if [ "$efi_num" -ge 80 ]; then
                   record warn efi "EFI-раздел занят на $efi_use" "убери старые ядра: sudo xbps-remove -oO"
               else
                   record ok efi "EFI-раздел занят на $efi_use"
               fi ;;
        esac
    fi
fi

if has_section updates; then
    heading "Обновления"
    n=$(xbps-install -un 2>/dev/null | wc -l)
    if [ "$n" -eq 0 ]; then
        record ok updates "система обновлена"
    else
        record warn updates "доступно обновлений: $n" "sudo xbps-install -Su"
    fi
fi

if has_section configs; then
    heading "Конфигурация"
    if [ -f "$HOME/.config/dms/settings.json" ]; then
        record ok dms-config "настройки DMS на месте"
    else
        record warn dms-config "нет ~/.config/dms/settings.json"
    fi
    if [ -f "$HOME/.config/niri/config.kdl" ]; then
        record ok niri-config "конфиг niri на месте"
    else
        record bad niri-config "нет ~/.config/niri/config.kdl"
    fi
    if [ -d "$HOME/.config/dms/plugins/.repos" ]; then
        record ok dms-plugins "кеш плагинов DMS присутствует"
    elif [ -f "$HOME/.config/dms/plugins.lock.json" ]; then
        record warn dms-plugins "плагины не развёрнуты" "dms plugins restore"
    fi
fi

if [ "$JSON" = 1 ]; then
    printf '{"errors":%s,"warnings":%s,"items":[%s]}\n' "$ERRORS" "$WARNINGS" "${JSON_ITEMS%,}"
fi

if [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
    printf '\n'
    if [ "$ERRORS" -gt 0 ]; then
        printf '%s[!!]%s ошибок: %s, предупреждений: %s\n' "$C_BAD" "$C_OFF" "$ERRORS" "$WARNINGS"
    elif [ "$WARNINGS" -gt 0 ]; then
        printf '%s[--]%s предупреждений: %s\n' "$C_WARN" "$C_OFF" "$WARNINGS"
    else
        printf '%s[ok]%s всё в порядке\n' "$C_OK" "$C_OFF"
    fi
fi

[ "$ERRORS" -gt 0 ] && exit 2
[ "$WARNINGS" -gt 0 ] && exit 1
exit 0
