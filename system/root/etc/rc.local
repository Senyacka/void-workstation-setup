#!/bin/sh
# Default rc.local for void; add your custom commands here.
#
# This is run by runit in stage 2 before the services are executed
# (see /etc/runit/2).

# Политика питания по источнику (turbo/RAPL/ASPM/яркость) + debugfs для статистики s0ix.
[ -x /usr/local/sbin/power-sync ] && /usr/local/sbin/power-sync auto

# Повтор позже: ACPI-источники питания и EC могут быть готовы не сразу после stage 2.
( sleep 12; [ -x /usr/local/sbin/power-sync ] && /usr/local/sbin/power-sync auto ) &
